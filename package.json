{
  "name": "safeboard",
  "version": "1.0.0",
  "description": "세이프보드 - 보안 강화 게시판 (Next.js + TypeScript + MongoDB)",
  "scripts": {
    "predev": "node scripts/check-db.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.11.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  }
}
