# 이 파일을 복사해서 .env.local 을 만드세요:  cp .env.example .env.local

# MongoDB 연결 문자열 (로컬 MongoDB 기본값)
# Atlas 를 쓴다면 mongodb+srv://<user>:<password>@<cluster>/safeboard 형태로 바꾸세요.
MONGODB_URI=mongodb://127.0.0.1:27017/safeboard

# HTTPS 로 배포할 때만 true (세션 쿠키에 Secure 속성 추가)
COOKIE_SECURE=false

# 시드 스크립트(npm run seed)가 만드는 관리자 계정 비밀번호 (개발용)
ADMIN_PASSWORD=Admin1234!
